# =============================================
# Bot Arbitrage HYPE: Hyperliquid ↔ HyperEVM
# Sub-2s block-aligned execution
# =============================================

PRIVATE_KEY=
WALLET_ADDRESS=

# =============================================
# HyperEVM
# =============================================
HYPERL_EVM_RPC=https://rpc.hyperliquid.xyz
# WebSocket pour block events temps-réel (auto-dérivé si absent)
# HYPERL_EVM_WS=wss://rpc.hyperliquid.xyz

# DEX (UniswapV2-like)
DEX_ROUTER_ADDRESS=
DEX_FACTORY_ADDRESS=

# Tokens (défauts corrects pour HyperEVM)
# WHYPE_ADDRESS=0x5555555555555555555555555555555555555555
# USDC_ADDRESS=0x0d01DC56dcAd1A5F2b34b58e1BeC6a328d9e43E8

# =============================================
# ARBITRAGE
# =============================================
MIN_SPREAD_PCT=0.5
TRADE_SIZE_USDC=100
MAX_TRADE_SIZE_USDC=1000
MAX_SLIPPAGE_PCT=0.3
MAX_GAS_PRICE_GWEI=50
DRY_RUN=true
AUTO_START=false

# Gas limit fixe (évite estimateGas RPC)
FIXED_GAS_LIMIT=300000

# Sécurité
MAX_LOSS_USD=50
MAX_TRADES_PER_HOUR=20
FETCH_TIMEOUT_MS=3000
TX_STUCK_TIMEOUT_MS=12000

# =============================================
# TELEGRAM
# =============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info
