# ============================================
# POLYMARKET LLM TRADING BOT - Configuration
# ============================================

# --- Polymarket CLOB API ---
# Votre clé privée Ethereum (wallet Polygon)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Adresse du wallet (funder address sur Polymarket)
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
# Polymarket API credentials (obtenu via createOrDeriveApiKey)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- LLM Configuration ---
# Fournisseur LLM: "openai" ou "anthropic"
LLM_PROVIDER=openai
# Clé API OpenAI
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
# Clé API Anthropic (si provider=anthropic)
ANTHROPIC_API_KEY=
# Modèle à utiliser
LLM_MODEL=gpt-4o

# --- Telegram ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Trading Parameters ---
# Volume cible journalier en USD
DAILY_VOLUME_TARGET=1000
# Taille max d'un seul trade en USD
MAX_TRADE_SIZE=50
# Taille min d'un seul trade en USD
MIN_TRADE_SIZE=5
# Max positions ouvertes simultanées
MAX_OPEN_POSITIONS=10
# Intervalle entre les cycles de trading (en secondes)
TRADING_INTERVAL=60
# Spread maximum acceptable (en %)
MAX_SPREAD=5
# Activer le mode dry-run (pas de vrais trades)
DRY_RUN=true
