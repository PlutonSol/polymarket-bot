# =============================================
# Bot Arbitrage Hyperliquid / HyperEVM
# =============================================

# Clé privée du wallet (sans le 0x)
PRIVATE_KEY=

# Adresse du wallet
WALLET_ADDRESS=

# =============================================
# HyperEVM DEX
# =============================================

# RPC HyperEVM
HYPERL_EVM_RPC=https://rpc.hyperliquid.xyz

# Adresses du DEX (UniswapV2-like sur HyperEVM)
# Exemples pour HyperSwap / KittenSwap / etc.
DEX_ROUTER_ADDRESS=
DEX_FACTORY_ADDRESS=

# Adresses tokens
WHYPE_ADDRESS=0x5555555555555555555555555555555555555555
USDC_ADDRESS=0x0d01DC56dcAd1A5F2b34b58e1BeC6a328d9e43E8

# =============================================
# ARBITRAGE
# =============================================

# Spread minimum pour déclencher un arbitrage (%)
MIN_SPREAD_PCT=0.5

# Montant par trade (USDC)
TRADE_SIZE_USDC=100

# Montant max par trade (USDC)
MAX_TRADE_SIZE_USDC=1000

# Slippage maximum toléré (%)
MAX_SLIPPAGE_PCT=0.3

# Intervalle de scan (ms)
SCAN_INTERVAL_MS=3000

# Gas price max (gwei)
MAX_GAS_PRICE_GWEI=50

# Mode dry-run (true = pas de trades réels)
DRY_RUN=true

# Démarrer automatiquement le scan
AUTO_START=false

# =============================================
# TELEGRAM
# =============================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================
# LOGGING
# =============================================

# Niveaux: debug, info, warn, error
LOG_LEVEL=info
