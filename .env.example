# =============================================
# Bot Arbitrage HYPE: Hyperliquid ↔ HyperEVM
# =============================================

# Clé privée du wallet (sans le 0x)
PRIVATE_KEY=
WALLET_ADDRESS=

# =============================================
# HyperEVM
# =============================================
HYPERL_EVM_RPC=https://rpc.hyperliquid.xyz

# Adresses DEX (UniswapV2-like sur HyperEVM)
DEX_ROUTER_ADDRESS=
DEX_FACTORY_ADDRESS=

# Adresses tokens (défauts corrects pour HyperEVM)
# WHYPE_ADDRESS=0x5555555555555555555555555555555555555555
# USDC_ADDRESS=0x0d01DC56dcAd1A5F2b34b58e1BeC6a328d9e43E8

# =============================================
# ARBITRAGE
# =============================================
MIN_SPREAD_PCT=0.5
TRADE_SIZE_USDC=100
MAX_TRADE_SIZE_USDC=1000
MAX_SLIPPAGE_PCT=0.3
SCAN_INTERVAL_MS=1000
MAX_GAS_PRICE_GWEI=50
DRY_RUN=true
AUTO_START=false

# Sécurité
MAX_LOSS_USD=50
MAX_TRADES_PER_HOUR=20
FETCH_TIMEOUT_MS=5000

# =============================================
# TELEGRAM
# =============================================
TELEGRAM_BOT_TOKEN=
# OBLIGATOIRE si TELEGRAM_BOT_TOKEN est défini (sécurité)
TELEGRAM_CHAT_ID=

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info
