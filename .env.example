# ============================================
# POLYMARKET SCALPING BOT - Configuration
# ============================================

# --- Polymarket CLOB API ---
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- LLM Configuration ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o

# --- Telegram ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Scalping Parameters ---
# Volume minimum du marché pour être éligible (en USD)
MIN_MARKET_VOLUME=1000000
# Tick de scalp: acheter au bid et revendre à bid + SCALP_TICK
SCALP_TICK=0.01
# Taille par scalp en USD
TRADE_SIZE_USD=50
# Taille max par scalp en USD
MAX_TRADE_SIZE=200
# Taille min par scalp en USD
MIN_TRADE_SIZE=5
# Volume cible journalier en USD
DAILY_VOLUME_TARGET=5000
# Intervalle entre les cycles de scalping (en secondes)
SCALP_INTERVAL=30
# Nombre max de scalps par cycle
MAX_CONCURRENT_SCALPS=3
# Timeout pour un sell après un buy (en secondes)
SCALP_TIMEOUT=60
# Spread max acceptable en cents
MAX_SPREAD_CENTS=3
# Liquidité min dans le book en USD
MIN_BOOK_DEPTH_USD=500
# Mode simulation (true = pas de vrais trades)
DRY_RUN=true
